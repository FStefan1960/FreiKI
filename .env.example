# ── Lokal erzeugt – diese Datei NICHT ins Git/Repo committen, nur per scp auf den Server kopieren ──

# --- PostgreSQL: Container-Initialisierung (offizielles postgres-Image) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- PostgreSQL: App-Verbindung (freiki-ui, andere Variablennamen als oben!) ---
# PG_PASS_KB ist Pflichtfeld (REQUIRED_ENV) - App startet ohne nicht.
PG_HOST=PostgreSQL
PG_DB=freiki
PG_USER_KB=freiki_user
PG_PASS_KB=

# --- n8n ---
N8N_HOST=
WEBHOOK_URL=
N8N_ENCRYPTION_KEY=
N8N_WEBHOOK_URL=
# API-Key (generiert in n8n UI unter Settings → API)
N8N_API_KEY=
# Telemetrie deaktivieren
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false

# --- LLM-Backend: DeepInfra (OpenAI-kompatibel) ---
# Modell: Qwen/Qwen3-32B (40k Kontext) – bereits fest in server.js eingetragen
VLLM_URL=
VLLM_API_KEY=
VLLM_MODEL=
# Embedding: BAAI/bge-m3 – bereits fest in server.js eingetragen (EMBED_MODEL)
VLLM_EMBED_URL=

# --- Whisper (Transkription) ---
# Auf CPU empfiehlt sich ein kleineres Modell als auf GPU-Servern (large-v3 ist auf CPU sehr langsam)
WHISPER_MODEL=

# --- FreiKI App ---
APP_URL=
JWT_SECRET=
KB_INGEST_API_KEY=
BOT_API_KEY=
HILFE_KB_TABLE=

# --- Brand-Konfiguration (White-Label) ---
APP_NAME=
APP_COLOR=
APP_COLOR_HOVER=
APP_COLOR_ACTIVE=
APP_NAVY=
APP_LOGO=
APP_LOGO_SIDEBAR=
APP_TAGLINE=
APP_SW_VERSION=
APP_SUPPORT_EMAIL=
APP_DEMO_MODE=
APP_FOOTER_NOTE=

# Pflichtschulung beim ersten Login (Folien unter public/training/default/slide-N.jpg und
# public/training/bgt/slide-N.jpg - instanzspezifischer Inhalt, hier nicht im Repo).
APP_MANDATORY_TRAINING=
# Öffentliches Anmeldeformular (/register.html, /api/register) mit Admin-Freischaltung.
# Vorsicht bei öffentlich erreichbaren Demo-Instanzen - bewusst per Flag statt Default an.
APP_SELF_REGISTRATION=
# METACOM-Nutzung als Nutzerfeld (nur die Datenpflege, keine echte Integration).
APP_USE_METACOM=
# Sammelpostfach für Selbstregistrierungs-Benachrichtigungen, zusätzlich zu allen
# Admin-Konten mit hinterlegter E-Mail. Nur relevant bei APP_SELF_REGISTRATION=true.
REGISTRATION_NOTIFY_EMAIL=

# --- Native Berichts-Module (freiki-ui/src/jobs/) - alle optional, Job überspringt sich
# selbst, wenn die nötigen Werte fehlen. Tageslosung/IT-Sicherheitslage brauchen nur
# VLLM_URL/VLLM_MODEL (oben) und laufen ohne weitere Konfiguration. ---
WEATHER_WARN_LAT=
WEATHER_WARN_LON=
WEATHER_WARN_RECIPIENTS=
# Amtlicher Gemeindeschlüssel (AGS), siehe warnung.bund.de API-Dokumentation.
NINA_WARN_AGS=
NINA_WARN_RECIPIENTS=
# Zielgruppen-Text für den LLM-Gedanken der Tageslosung. Leer = generischer Default.
TAGESLOSUNG_AUDIENCE=
# Passwort des dedizierten "healthcheck"-Testnutzers (synthetischer Health-Check, testet
# echten Login+RAG-Chat-Pfad). Nutzer muss vorher angelegt sein (Rolle: default reicht).
HEALTHCHECK_PASSWORD=
# Signal-Alert bei vLLM-Ausfall (CallMeBot: https://www.callmebot.com/blog/signal-api/).
# Ohne beide Werte bleibt der Monitor inaktiv - macht ohnehin nur mit eigenem vLLM Sinn.
SIGNAL_PHONE=
SIGNAL_APIKEY=

# --- Mattermost (Team-Chat, OIDC-Login + n8n-Bot) ---
MATTERMOST_URL=
MATTERMOST_OIDC_CLIENT_ID=
MATTERMOST_OIDC_CLIENT_SECRET=
MATTERMOST_OIDC_REDIRECT_URI=
# Personal Access Token (n8n Bot-Posts)
MATTERMOST_BOT_TOKEN=

# --- Paperless-ngx (Dokumentenarchiv, Quelle für Wissensbereiche) ---
PAPERLESS_URL=
PAPERLESS_ADMIN_URL=
PAPERLESS_INTERNAL_URL=
PAPERLESS_SECRET_KEY=
PAPERLESS_ADMIN_USER=
PAPERLESS_ADMIN_PASSWORD=
PAPERLESS_TOKEN=

# --- Mailserver (eigener SMTP + IMAP, docker-mailserver) ---
MAIL_DOMAIN=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
